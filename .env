# ==================== 公共配置（和SpringBoot公共properties一样） ====================
# 所有服务共用的端口，无需重复写
VITE_USER_API_PORT=8083
VITE_BOOK_API_PORT=8085
VITE_AI_CHAT_API_PORT=8086
VITE_ORDER_API_PORT=8088
VITE_CONNECT_API_PORT=8093
VITE_ACCOUNT_API_PORT=8087
VITE_WS_API_PORT=8094

# 自动拼接完整接口地址（核心：${变量引用}，和SpringBoot完全相同）
VITE_USER_API_BASE="http://${VITE_BASE_IP}:${VITE_USER_API_PORT}"
VITE_BOOK_API_BASE="http://${VITE_BASE_IP}:${VITE_BOOK_API_PORT}"
VITE_AI_CHAT_API_BASE="http://${VITE_BASE_IP}:${VITE_AI_CHAT_API_PORT}"
VITE_ORDER_API_BASE="http://${VITE_BASE_IP}:${VITE_ORDER_API_PORT}"
VITE_CONNECT_API_BASE="http://${VITE_BASE_IP}:${VITE_CONNECT_API_PORT}"
VITE_ACCOUNT_API_BASE="http://${VITE_BASE_IP}:${VITE_ACCOUNT_API_PORT}"
VITE_WS_API_BASE="ws://${VITE_BASE_IP}:${VITE_WS_API_PORT}/ws"

#租房配置
VITE_BASE_IP=192.168.124.9

